    function openProjectModal(key) {
      const data = projectData[key] || projectData.excalibur;
      const modal = document.getElementById('projectModal');
      const card = document.getElementById('modalCard');

      document.getElementById('modalMetaCategory').textContent = data.category;
      document.getElementById('modalProjectTitle').textContent = data.title;
      document.getElementById('modalMainImg').src = data.image;
      document.getElementById('modalMainImg').alt = data.title;
      document.getElementById('modalPlaceholder1').textContent = data.slot1;
      document.getElementById('modalPlaceholder2').textContent = data.slot2;
      document.getElementById('modalPlaceholder3').textContent = data.slot3;
      document.getElementById('modalRoleDetail').textContent = data.role;
      document.getElementById('modalToolsDetail').textContent = data.tools;

      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');

      setTimeout(() => {
        card.classList.remove('modal-enter');
        card.classList.add('modal-enter-active');
      }, 10);
    }

    function closeProjectModal() {
      const modal = document.getElementById('projectModal');
      const card = document.getElementById('modalCard');
      card.classList.remove('modal-enter-active');
      card.classList.add('modal-exit');
      
      setTimeout(() => {
        modal.classList.add('hidden');
        card.classList.remove('modal-exit');
        card.classList.add('modal-enter');
        document.body.classList.remove('overflow-hidden');
      }, 180);
    }

    document.getElementById('projectModal')?.addEventListener('click', (e) => {
      if (e.target.id === 'projectModal') {
        closeProjectModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const modal = document.getElementById('projectModal');
        if (modal && !modal.classList.contains('hidden')) {
          closeProjectModal();
        }
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      const filterButtons = document.querySelectorAll('[data-purpose="project-filters"] button');
      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => {
            b.classList.remove('text-black', 'font-extrabold', 'border-b-2', 'border-black');
            b.classList.add('text-[#777777]');
          });
          btn.classList.add('text-black', 'font-extrabold', 'border-b-2', 'border-black');
          btn.classList.remove('text-[#777777]');
        });
      });
    });
